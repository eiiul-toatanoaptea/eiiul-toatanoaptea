#  ~/Developer/Rubbish/Makefile
% ppy NewSourceFromTemplate.py ~/Documents/Templates/*.rkt
import os
import os.path
import re
import sys
import sysconfig

if len(sys.argv) < 2:
   raise SystemExit

h = os.environ['HOME']
r = h + "/Documents/Templates/"
is_main = False
i_argv = 1
if sys.argv[i_argv] == "-m":
   is_main = True
   i_argv += 1

while i_argv < len(sys.argv):
   t = os.path.basename(sys.argv[i_argv]).split(".")
   if 1 < len(t):
      if t[0] != "":
         f, e = ".".join(t[:-1]), "." + t[-1]
      else:
         f, e = "." + t[1], ""
   else:
      f, e = t[0], ""

   if e == ".c":
      if is_main:
         b = "c_main"
      #  d = b.upper()
      #  c = f.upper()
         for k in open(r + b + e):
         #  print(k.rstrip().replace(d, c).replace(b, f))
            print(k.rstrip().replace(b, f))

      else:
         b = "c_body"
         d = b.upper()
         c = f.upper()
         for k in open(r + b + e):
            print(k.rstrip().replace(d, c).replace(b, f))

   elif e == ".m":
      if is_main:
         b = "objc_main"
      #  d = b.upper()
      #  c = f.upper()
         for k in open(r + b + e):
         #  print(k.rstrip().replace(d, c).replace(b, f))
            print(k.rstrip().replace(b, f))

      else:
         b = "objc_body"
         d = b.upper()
         c = f.upper()
         for k in open(r + b + e):
            print(k.rstrip().replace(d, c).replace(b, f))

   elif e == ".h":
      b = "c_spec"
      d = b.upper()
      c = f.upper()
      for k in open(r + b + e):
         print(k.rstrip().replace(d, c).replace(b, f))

   elif e == ".rkt" and is_main:
   #  print("#!/usr/bin/racket")
      b = "racket_script"
      for k in open(r + b + e):
         print(k.rstrip().replace(b, f))

   elif e == ".rkt":
      b = "racket_imple"
      for k in open(r + b + e):
         print(k.rstrip().replace(b, f))

   elif e == ".swift":
      if is_main:
         b = "swift_main"
      else:
         b = "swift_imple"
      for k in open(r + b + e):
         print(k.rstrip().replace(b, f))

   elif e == ".txt" or e == ".log":
      b = "text_file"
      for k in open(r + b + ".txt"):
         print(k.rstrip().replace(b, f).replace(".txt", e))

   elif e == ".php":
      b = "php_file"
      for k in open(r + b + e):
         print(k.rstrip().replace(b, f))

   else:
      d = os.path.dirname(sys.argv[i_argv]).replace(h, "~")
      print("\n\n;*\t" + d + f + e)

   i_argv += 1

